# Opsark Admin 本地开发配置（本文件已被 Git 忽略，请勿提交）
# 这里只放部署与安全配置；供应商名称、完整 API 地址、上游 API Key、
# 超时和模型名称均在 Admin 后台页面维护。

# 本地数据库。生产环境应改用独立 PostgreSQL，并做好备份。
DATABASE_URL=sqlite:///./data/platform.db

# 生产环境通过 HTTPS 提供服务，认证 Cookie 仅允许安全传输。
COOKIE_SECURE=true

# 允许访问 Admin API 的前端来源，逗号分隔。不要把模型供应商域名写在这里。
ALLOWED_ORIGINS=https://zgspace.cn

# 用于加密数据库里的供应商 API Key。
# 必须单独备份；已有供应商后不可随意替换，否则旧 API Key 将无法解密。
# 新环境生成命令：
# .\.venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_KEY_ENCRYPTION_KEY=FfuGSzIvBRjHrSUmdAnm5S7rYi7GAaicdysLkg0hvyw=

# GitHub OAuth App。Client Secret 仅填写在服务器环境中，禁止提交到仓库。
GITHUB_CLIENT_ID=Ov23li9wegtr4OvOmtIW
GITHUB_CLIENT_SECRET=801e4ff5d6fb575a255dc3a15bdfa132b562c334
GITHUB_CALLBACK_URL=https://zgspace.cn/api/core/v1/auth/github/callback
